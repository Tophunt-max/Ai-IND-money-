# Starter .env for the AWS host (docs/deployment/aws.md). deploy/aws/user-data.sh copies it to
# ~/Ai-IND-money-/.env on first boot. Fill in the values, then: docker compose up -d
# Everything not listed here keeps its default; the full list is in the repo's .env.example.
# Write `$$` for a literal `$` in a value.

# ===== AI (required): https://aistudio.google.com/apikey =====
SKOPAQ_GOOGLE_API_KEY=

# ===== Database: Supabase -> Project Settings -> API =====
# Run supabase/migrations/001..003 in the SQL Editor first.
SKOPAQ_SUPABASE_URL=
SKOPAQ_SUPABASE_ANON_KEY=
SKOPAQ_SUPABASE_SERVICE_KEY=

# ===== Mode: stay on paper until the paper results are reviewed =====
SKOPAQ_TRADING_MODE=paper
SKOPAQ_SCHEDULER_ENABLED=true
SKOPAQ_SCHEDULER_MODE=paper
SKOPAQ_SCHEDULER_CONFIRM_LIVE=false

# ===== The Elastic IP (INDstocks whitelists it; deploy/aws/check.sh compares it) =====
SKOPAQ_EXPECTED_EGRESS_IP=

# ===== Telegram (optional): token from @BotFather; send the bot /start for the chat ID =====
# Without a token start only api and scheduler: docker compose up -d api scheduler
SKOPAQ_TELEGRAM_BOT_TOKEN=
SKOPAQ_TELEGRAM_CHAT_ID=
SKOPAQ_TELEGRAM_ALLOWED_CHAT_IDS=

# ===== Live trading only (later): INDstocks token, or `skopaq token set <token>` =====
SKOPAQ_INDSTOCKS_TOKEN=
